# Review server settings. Copy to .env.staging on the server and fill in every value.
# Never commit .env.staging. Generate random values on the server with:  openssl rand -base64 48

# The address staff will use (domain and/or the server IP), comma separated.
DJANGO_ALLOWED_HOSTS=review.example.com
# With a domain and HTTPS (CloudPanel Let's Encrypt): the https address, and STAGING_HTTPS=true.
CSRF_TRUSTED_ORIGINS=https://review.example.com
STAGING_HTTPS=true

# Long random strings (at least 50 characters for the secret key).
DJANGO_SECRET_KEY=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
BLIND_INDEX_KEY=
# An encryption key for Civil IDs and medical notes: openssl rand -base64 32 | tr '+/' '-_'
# Keep a copy somewhere safe: without it the encrypted test data can't be read.
FIELD_ENCRYPTION_KEYS=

# The password every test account (ceo@test.elite.local, ops@…, admin.prm@…) uses on this server.
# Share it only with the reviewers. At least 12 characters, not a common word.
REVIEW_PASSWORD=
