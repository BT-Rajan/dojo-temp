# Copy to .env for local development. Never commit a real .env (ISO 27001 A.8.24 / A.5.33).
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 8 — database must use utf8mb4 so Arabic text is stored correctly:
#   CREATE DATABASE elite CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DATABASE_URL=mysql://elite:elite-dev-only@127.0.0.1:3306/elite

REDIS_URL=redis://127.0.0.1:6379/0

# Field encryption for Civil IDs and medical notes.
# Comma-separated Fernet keys; the FIRST key encrypts, all keys decrypt (allows key rotation).
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=
# Secret used to build searchable fingerprints (blind index) of Civil IDs. Long random string.
BLIND_INDEX_KEY=

# Require two-factor login for privileged roles (CEO, Operations Manager, Systems & IT, Accountant).
ENFORCE_PRIVILEGED_MFA=false

# Admin site path (kept non-obvious in production).
ADMIN_URL=admin/

# Email for receipts and scheduled reports (development prints to the console)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Elite Academy <no-reply@elitemaacademy.com>

# SAQR and the Staff Assistant (open item O-20). Leave AI_ENABLED off until the provider is agreed;
# the rule-based engines answer meanwhile. Never commit a real key.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
